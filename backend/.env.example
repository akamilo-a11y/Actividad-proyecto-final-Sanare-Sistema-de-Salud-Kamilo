# Base de datos PostgreSQL (en Render o externa)
DATABASE_URL=postgresql://usuario:password@host:5432/saludpublica?schema=public

# Redis (en Render o Upstash / Redis Cloud)
# Se puede usar REDIS_URL o host/port por separado:
REDIS_URL=redis://default:password@host:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Servidor
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://tu-frontend.onrender.com,http://localhost:3000

# Seguridad JWT
JWT_SECRET=tu_secreto_super_seguro_jwt_aqui

# Inteligencia Artificial (Google Gemini)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Notificaciones por correo (opcional, si se deja vacío se usa cuenta Ethereal de prueba)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="SaludPública Connect <no-reply@saludpublica.gob.ar>"
